{% comment %} Shopify dynamic section: Success Client {% endcomment %}
<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  .success-client-section {
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    color: #fff;
  }

  .success-client-section .container {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
  }

  #{{ section.id }} {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: clamp(70px, 9vw, 120px) 0;
    background: radial-gradient(circle at 8% 12%, rgba(255, 87, 34, 0.16), transparent 28%),
      radial-gradient(circle at 88% 18%, rgba(255, 255, 255, 0.08), transparent 24%),
      linear-gradient(135deg, #181818 0%, #252525 52%, #111 100%);
  }

  #{{ section.id }}::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.24;
    background-image: linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
    background-size: 54px 54px;
    mask-image: linear-gradient(to bottom, transparent, #000 16%, #000 72%, transparent);
  }

  .success-client-section .success-header {
    gap: 36px;
    align-items: end;
    margin-bottom: clamp(34px, 5vw, 64px);
  }

  .success-client-section .sub-heading {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 38px;
    margin-bottom: 18px;
    padding: 8px 14px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    color: #f4f4f4;
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(12px);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .success-client-section .sub-heading svg {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
  }

  .success-client-section .main-heading {
    max-width: 920px;
    font-size: clamp(34px, 6vw, 72px);
    line-height: 1.02;
    font-weight: 650;
    letter-spacing: 0;
  }

  .success-client-section .main-heading span {
    display: block;
  }

  .success-client-section .main-heading .accent-font {
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 400;
  }

  .success-client-section .main-heading .muted {
    color: #9d9d9d;
  }

  .success-client-section .header-note {
    max-width: 270px;
    color: #b8b8b8;
    font-size: 15px;
    line-height: 1.7;
  }

  .success-client-section .card_wraper .row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
  }

  .success-client-section .card_wraper .card {
    position: relative;
    min-height: 285px;
    overflow: hidden;
    padding: clamp(22px, 3vw, 32px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.09), rgba(255, 255, 255, 0.025)),
      rgba(255, 255, 255, 0.035);
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.22);
    transform: translateZ(0);
  }

  .success-client-section .card_wraper .card::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    background: linear-gradient(135deg, rgba(255, 87, 34, 0.2), transparent 48%);
    transition: opacity 0.35s ease;
  }

  .success-client-section .card_wraper .card::after {
    content: '';
    position: absolute;
    right: -42px;
    bottom: -42px;
    width: 132px;
    height: 132px;
    border: 1px solid rgba(255, 87, 34, 0.32);
    border-radius: 50%;
  }

  .success-client-section .card_wraper .card:hover::before {
    opacity: 1;
  }

  .success-client-section .card-content {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 100%;
    flex-direction: column;
    justify-content: space-between;
    gap: 34px;
  }

  .success-client-section .metric-icon {
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    border-radius: 8px;
    background: rgba(255, 87, 34, 0.12);
    color: #ff7a4d;
  }

  .success-client-section .metric-icon svg {
    width: 22px;
    height: 22px;
  }

  .success-client-section .card_wraper .card h3 {
    margin-bottom: 12px;
    color: #fff;
    font-size: 15px;
    font-weight: 700;
  }

  .success-client-section .card_wraper .card h2 {
    margin-bottom: 18px;
    color: #ff5722;
    font-size: clamp(40px, 5vw, 58px);
    line-height: 0.95;
    font-weight: 760;
  }

  .success-client-section .card_wraper .card p {
    max-width: 260px;
    color: #b7b7b7;
    font-size: 15px;
    line-height: 1.65;
  }

  @media (max-width: 1024px) {
    .success-client-section .success-header {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .success-client-section .header-note {
      max-width: 680px;
    }

    .success-client-section .card_wraper .row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .success-client-section .container {
      width: min(100% - 28px, 1180px);
    }

    #{{ section.id }} {
      padding: 58px 0;
    }

    .success-client-section .success-header {
      margin-bottom: 28px;
    }

    .success-client-section .main-heading {
      font-size: clamp(31px, 11vw, 46px);
      line-height: 1.07;
    }

    .success-client-section .card_wraper .row {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .success-client-section .card_wraper .card {
      min-height: 245px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>

<section id="{{ section.id }}" class="success-client-section">
  <div class="container">
    <div class="success-header">
      <div>
        <div class="sub-heading">
          <span>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" aria-hidden="true">
              <path fill="currentColor"
                d="M208.5 32c0-17.7 14.3-32 32-32h32c17.7 0 32 14.3 32 32v140.9l122-70.4c15.3-8.8 34.9-3.6 43.7 11.7l16 27.7c8.8 15.3 3.6 34.9-11.7 43.7l-122 70.4 122 70.4c15.3 8.8 20.6 28.4 11.7 43.7l-16 27.7c-8.8 15.3-28.4 20.6-43.7 11.7l-122-70.4v140.9c0 17.7-14.3 32-32 32h-32c-17.7 0-32-14.3-32-32V339.1l-122 70.4c-15.3 8.8-34.9 3.6-43.7-11.7l-16-27.7c-8.8-15.3-3.6-34.9 11.7-43.7l122-70.4-122-70.4c-15.3-8.8-20.5-28.4-11.7-43.7l16-27.7c8.8-15.3 28.4-20.5 43.7-11.7l122 70.4V32z" />
            </svg>
          </span>
          <p>{{ section.settings.sub_heading }}</p>
        </div>

        <h2 class="main-heading">
          <span class="accent-font">{{ section.settings.heading_accent }}</span>
          <span style="color:#ffffff;">{{ section.settings.heading_primary }}</span>
          <span class="muted">{{ section.settings.heading_secondary }}</span>
        </h2>

        {% if section.settings.header_note != blank %}
          <p class="header-note">{{ section.settings.header_note }}</p>
        {% endif %}
      </div>
    </div>

    <div class="card_wraper">
      <div class="row">
        {% for block in section.blocks %}
          <div class="col-md-3">
            <div class="card">
              <div class="card-content">
                <div class="metric-icon" aria-hidden="true">
                  {% case block.settings.card_icon %}
                    {% when 'clients' %}
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                      </svg>
                    {% when 'projects' %}
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M12 20v-6" />
                        <path d="M6 20V10" />
                        <path d="M18 20V4" />
                      </svg>
                    {% when 'growth' %}
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M12 2v20" />
                        <path d="m17 5-5-3-5 3" />
                        <path d="m17 19-5 3-5-3" />
                      </svg>
                    {% when 'satisfaction' %}
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                      </svg>
                    {% else %}
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <circle cx="12" cy="12" r="9" />
                        <path d="M8 12h8" />
                        <path d="M12 8v8" />
                      </svg>
                  {% endcase %}
                </div>
                <div>
                  <h3>{{ block.settings.card_title }}</h3>
                  <h2>
                    <span class="counter" data-target="{{ block.settings.card_value | default: 0 }}">0</span>
                    {{- block.settings.card_suffix }}
                  </h2>
                  <p>{{ block.settings.card_description }}</p>
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% comment %}
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
{% endcomment %}
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const sectionRoot = document.querySelector('#{{ section.id }}');
    if (!sectionRoot || typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
      return;
    }

    gsap.registerPlugin(ScrollTrigger);
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const setElements = (selector) => sectionRoot.querySelectorAll(selector);

    if (!reduceMotion) {
      gsap.set(setElements('.sub-heading, .main-heading span, .header-note, .card'), {
        autoAlpha: 0,
        y: 36,
      });

      const introTimeline = gsap.timeline({
        scrollTrigger: {
          trigger: sectionRoot,
          start: 'top 72%',
          end: 'bottom 18%',
          toggleActions: 'restart reverse restart reverse',
        },
      });

      introTimeline
        .to(setElements('.sub-heading'), {
          autoAlpha: 1,
          y: 0,
          duration: 0.65,
          ease: 'power3.out',
        })
        .to(
          setElements('.main-heading span'),
          {
            autoAlpha: 1,
            y: 0,
            duration: 0.75,
            stagger: 0.12,
            ease: 'power3.out',
          },
          '-=0.28'
        )
        .to(
          setElements('.header-note'),
          {
            autoAlpha: 1,
            y: 0,
            duration: 0.65,
            ease: 'power3.out',
          },
          '-=0.45'
        )
        .to(
          setElements('.card'),
          {
            autoAlpha: 1,
            y: 0,
            duration: 0.8,
            stagger: 0.12,
            ease: 'power3.out',
          },
          '-=0.28'
        );

      const cards = setElements('.card-content');
      cards.forEach((content, index) => {
        gsap.to(content, {
          y: index % 2 === 0 ? -16 : 16,
          ease: 'none',
          scrollTrigger: {
            trigger: sectionRoot,
            start: 'top bottom',
            end: 'bottom top',
            scrub: 1.1,
          },
        });
      });

      setElements('.counter').forEach((counter) => {
        const target = Number(counter.dataset.target);

        const playCounter = () => {
          const value = { number: 0 };
          if (counter.countTween) counter.countTween.kill();
          counter.textContent = '0';
          counter.countTween = gsap.to(value, {
            number: target,
            duration: 1.8,
            ease: 'power2.out',
            onUpdate: () => {
              counter.textContent = Math.round(value.number);
            },
          });
        };

        ScrollTrigger.create({
          trigger: counter,
          start: 'top 86%',
          end: 'bottom 12%',
          onEnter: playCounter,
          onEnterBack: playCounter,
          onLeave: () => {
            counter.textContent = '0';
          },
          onLeaveBack: () => {
            counter.textContent = '0';
          },
        });
      });
    } else {
      setElements('.counter').forEach((counter) => {
        counter.textContent = counter.dataset.target;
      });
    }
  });
</script>

{% schema %}
{
  "name": "Success Client",
  "settings": [
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Sub heading",
      "default": "Why choose us"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Accent heading",
      "default": "Transforming modern business ideas"
    },
    {
      "type": "text",
      "id": "heading_primary",
      "label": "Primary heading",
      "default": "into innovative global solutions"
    },
    {
      "type": "text",
      "id": "heading_secondary",
      "label": "Secondary heading",
      "default": "that inspire long-term success."
    },
    {
      "type": "textarea",
      "id": "header_note",
      "label": "Header note",
      "default": "Partner with us for strategy, execution, and long-term growth."
    }
  ],
  "blocks": [
    {
      "type": "metric",
      "name": "Metric card",
      "settings": [
        {
          "type": "text",
          "id": "card_title",
          "label": "Card title",
          "default": "Happy Clients"
        },
        {
          "type": "number",
          "id": "card_value",
          "label": "Counter value",
          "default": 150
        },
        {
          "type": "text",
          "id": "card_suffix",
          "label": "Suffix",
          "default": "+"
        },
        {
          "type": "textarea",
          "id": "card_description",
          "label": "Description",
          "default": "Trusted by a growing client base that depends on clear strategy and consistent delivery."
        },
        {
          "type": "select",
          "id": "card_icon",
          "label": "Icon type",
          "options": [
            { "value": "clients", "label": "Clients" },
            { "value": "projects", "label": "Projects" },
            { "value": "growth", "label": "Growth" },
            { "value": "satisfaction", "label": "Satisfaction" }
          ],
          "default": "clients"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Success Client",
      "category": "Custom",
      "blocks": [{ "type": "metric" }, { "type": "metric" }, { "type": "metric" }, { "type": "metric" }]
    }
  ]
}
{% endschema %}
